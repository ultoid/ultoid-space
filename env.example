# ================================================================
# Ultoid Space — Environment Variables
# Salin file ini menjadi ".env" dan isi nilainya
# JANGAN pernah commit file .env ke Git!
# ================================================================

# Secret key Flask — generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
# Jika dikosongkan, app akan generate otomatis dan menyimpannya di data/.secret_key
ULTOID_SECRET_KEY=

# Kredensial admin awal; wajib diisi bila data/credentials.txt belum ada
ULTOID_ADMIN_USERNAME=admin
ULTOID_ADMIN_PASSWORD=

# Google Gemini API Key
GEMINI_API_KEY=

# Ruto V1 — Gemini API dan pilihan model Gemma di Pengaturan Ruto.
RUTO_PROVIDER=gemini
RUTO_MODEL=gemma-4-31b-it

# Opsional: provider lain yang kompatibel dengan OpenAI Chat Completions.
# RUTO_PROVIDER=openai-compatible
# RUTO_MODEL=nama-model
# RUTO_API_BASE_URL=https://api.example.com/v1
# RUTO_API_KEY=isi_api_key_provider
