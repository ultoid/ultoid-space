# ================================================================
# Ultoid Space — Environment Variables
# Salin file ini menjadi ".env" dan isi nilainya
# JANGAN pernah commit file .env ke Git!
# ================================================================

# Secret key Flask — generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
# Jika dikosongkan, app akan generate otomatis dan menyimpannya di data/.secret_key
ULTOID_SECRET_KEY=

# Google Gemini / Gemini API Key
# Gunakan environment variable GEMINI_API_KEY untuk akses AI
GEMINI_API_KEY=

# RapidAPI Key untuk Instagram & TikTok scraper
# Dapatkan dari: https://rapidapi.com/
# SEGERA revoke key lama yang sudah bocor: 7ba238277amsh59da4df95e2d6f0p1ebabdjsn7afdd25b94d9
RAPIDAPI_KEY=
